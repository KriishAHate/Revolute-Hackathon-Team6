# Required: the Hugging Face dataset repository to create/use.
HF_DATASET_REPO=your-hf-org/prompt-to-platter-robot-data

# Only affects repository creation. Existing repository visibility is unchanged.
HF_DATASET_PRIVATE=true

# Optional: use a fine-grained write token for headless setup. Prefer `hf auth login`.
# HF_TOKEN=hf_replace_me

# Optional: absolute path recommended for a large Jetson NVMe volume.
COLLECTION_ROOT=./data/sessions

# Optional: enables faster Xet-backed uploads when CPU/network capacity allows.
HF_XET_HIGH_PERFORMANCE=0
