#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON="$PROJECT_DIR/.venv/bin/python"

usage() {
  cat <<'EOF'
Prompt to Platter — Jetson data collection

Usage:
  ./collector setup
  ./collector doctor
  ./collector init-hf
  ./collector new --task "..." --robot-id "..." [--camera NAME ...]
  ./collector sessions
  ./collector finalize SESSION_PATH_OR_ID [--sha256]
  ./collector upload SESSION_PATH_OR_ID

Commands:
  setup       Create the Python environment and install dependencies.
  doctor      Check configuration, disk space, Jetson tools, and Hub access.
  init-hf     Create/initialize the configured Hugging Face dataset.
  new         Create a session and print its output directory.
  sessions    List local sessions and their states.
  finalize    Close and inventory a session after recording stops.
  upload      Explicitly upload one finalized session.
EOF
}

require_environment() {
  if [[ ! -x "$PYTHON" ]]; then
    echo "ERROR: Environment not installed. Run: ./collector setup" >&2
    exit 1
  fi
}

command_name="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$command_name" in
  setup)
    exec "$PROJECT_DIR/scripts/bootstrap.sh"
    ;;
  doctor)
    require_environment
    exec "$PYTHON" "$PROJECT_DIR/scripts/doctor.py" "$@"
    ;;
  init-hf)
    require_environment
    exec "$PYTHON" "$PROJECT_DIR/scripts/init_hf_dataset.py" "$@"
    ;;
  new)
    require_environment
    exec "$PYTHON" "$PROJECT_DIR/scripts/new_session.py" "$@"
    ;;
  sessions)
    require_environment
    exec "$PYTHON" "$PROJECT_DIR/scripts/list_sessions.py" "$@"
    ;;
  finalize)
    require_environment
    exec "$PYTHON" "$PROJECT_DIR/scripts/finalize_session.py" "$@"
    ;;
  upload)
    require_environment
    exec "$PYTHON" "$PROJECT_DIR/scripts/upload_session.py" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "ERROR: Unknown command: $command_name" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac
